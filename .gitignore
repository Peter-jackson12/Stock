*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv32
.venv*

# ==========================================
# Environment & Secrets (비밀 키 및 환경 변수 무시 - 추가됨!)
# ==========================================
.env
*.env
.env.*

# ==========================================
# Practice & Temporary Files (연습용 및 임시 파일 무시)
# ==========================================
practice.ipynb
*.tmp

# ==========================================
# Large Data Files (대용량 데이터 및 DB 무시)
# ==========================================
*.db
*.sqlite
*.sqlite3

# ==========================================
# Run Store (L5) — 실행 결과 산출물
# 매니페스트/parquet 은 재실행으로 복원 가능한 산출물이므로 추적하지 않는다.
# ==========================================
runs/

# ==========================================
# Feature Store (L2) — 배치 피처 산출물
# 원천 데이터에서 재생성 가능하므로 추적하지 않는다.
#   uv run python scripts/build_features.py --date YYYYMMDD
# ==========================================
sampledata/features/
